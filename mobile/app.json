{
  "expo": {
    "name": "Mutter",
    "slug": "mutter",
    "scheme": "mutter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mutter-app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fbfbf8",
        "foregroundImage": "./assets/mutter-app-icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "com.anonymous.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "08fc7a47-cb41-479b-9dfc-8d6f879b7daa"
      }
    },
    "owner": "pranshu23xx"
  }
}
