+package com.rnfloatingbubble
+
+import android.accessibilityservice.AccessibilityService
+import android.accessibilityservice.AccessibilityServiceInfo
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.view.accessibility.AccessibilityEvent
+import android.view.accessibility.AccessibilityNodeInfo
+
+/** Shows the bubble only while another app has an editable field focused. */
+class MutterTextInputAccessibilityService : AccessibilityService() {
+
+    companion object {
+        const val ACTION_TRANSLATION_READY = "com.anonymous.mobile.TRANSLATION_READY"
+        const val EXTRA_TRANSLATION = "translation"
+    }
+
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    private val translationReceiver = object : BroadcastReceiver() {
+        override fun onReceive(context: Context?, intent: Intent?) {
+            val text = intent?.getStringExtra(EXTRA_TRANSLATION).orEmpty()
+            if (text.isBlank()) return
+            insertTextIntoFocusedField(text)
+        }
+    }
+
+    /**
+     * Sets the translated text into the currently focused editable field.
+     * Retries for a short window because the active window/node may not be
+     * resolvable the instant the translation broadcast arrives.
+     */
+    private fun insertTextIntoFocusedField(text: String) {
+        val arguments = Bundle().apply {
+            putCharSequence(
+                AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE,
+                text
+            )
+        }
+
+        fun tryInsert(): Boolean {
+            val node = rootInActiveWindow?.findFocus(AccessibilityNodeInfo.FOCUS_INPUT)
+                ?: return false
+            return try {
+                node.performAction(AccessibilityNodeInfo.ACTION_SET_TEXT, arguments)
+            } catch (_: Exception) {
+                false
+            } finally {
+                node.recycle()
+            }
+        }
+
+        if (tryInsert()) return
+
+        var attempts = 0
+        val retry = object : Runnable {
+            override fun run() {
+                if (tryInsert() || ++attempts >= 10) return
+                mainHandler.postDelayed(this, 250L)
+            }
+        }
+        mainHandler.postDelayed(retry, 250L)
+    }
+
+    override fun onServiceConnected() {
+        val filter = IntentFilter(ACTION_TRANSLATION_READY)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            registerReceiver(translationReceiver, filter, Context.RECEIVER_NOT_EXPORTED)
+        } else {
+            registerReceiver(translationReceiver, filter)
+        }
+        serviceInfo = serviceInfo.apply {
+            eventTypes = AccessibilityEvent.TYPE_VIEW_FOCUSED or
+                    AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED
+            feedbackType = AccessibilityServiceInfo.FEEDBACK_GENERIC
+            notificationTimeout = 100
+            flags = AccessibilityServiceInfo.FLAG_RETRIEVE_INTERACTIVE_WINDOWS
+        }
+    }
+
+    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
+        if (event == null) return
+
+        when (event.eventType) {
+            AccessibilityEvent.TYPE_VIEW_FOCUSED -> {
+                if (event.source?.isEditable == true) {
+                    FloatingBubbleService.showForTextInput(this)
+                } else {
+                    FloatingBubbleService.hideForTextInput(this)
+                }
+            }
+
+            AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED -> syncFocusedInput()
+        }
+    }
+
+    override fun onInterrupt() {
+        FloatingBubbleService.hideForTextInput(this)
+    }
+
+    override fun onDestroy() {
+        mainHandler.removeCallbacksAndMessages(null)
+        unregisterReceiver(translationReceiver)
+        FloatingBubbleService.hideForTextInput(this)
+        super.onDestroy()
+    }
+
+    private fun syncFocusedInput() {
+        val focusedNode = rootInActiveWindow?.findFocus(AccessibilityNodeInfo.FOCUS_INPUT)
+        if (focusedNode?.isEditable == true) {
+            FloatingBubbleService.showForTextInput(this)
+        } else {
+            FloatingBubbleService.hideForTextInput(this)
+        }
+        focusedNode?.recycle()
+    }
+}
