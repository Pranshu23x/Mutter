+package com.rnfloatingbubble
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+
+/**
+ * Restarts the floating bubble after a device reboot, if the user had it enabled
+ * before. Reuses FloatingBubbleService's existing prefs-based start logic (the same
+ * path the accessibility service uses to show the bubble for a focused text field) —
+ * it already checks the overlay permission and the stored "enabled" flag before
+ * starting anything, so a reboot on a device where the bubble was never turned on
+ * is a no-op here.
+ */
+class BootReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action == Intent.ACTION_BOOT_COMPLETED) {
+            FloatingBubbleService.showForTextInput(context)
+        }
+    }
+}
